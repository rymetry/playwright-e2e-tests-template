# テスト対象のbase URL。page.goto('/') などの基準になる。
E2E_BASE_URL=https://playwright.dev

# 許可済みoriginのカンマ区切り一覧。E2E_BASE_URLのoriginが含まれない場合、
# playwright.config.tsが起動時に失敗する。本番環境を入れないこと。
E2E_ALLOWED_ORIGINS=https://playwright.dev

# テスト専用アカウントの認証情報（認証が必要な場合のみ設定）。
# AIはこれらを環境変数展開でのみ使用し、値の読み取り・出力・記録は行わない。
# E2E_TEST_USER_EMAIL=
# E2E_TEST_USER_PASSWORD=
