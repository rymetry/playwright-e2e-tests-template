{
  "name": "playwright-e2e-tests-template",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": "^20.17.0 || >=22.9.0"
  },
  "packageManager": "npm@11.10.0+sha512.8bc844e37892200305b98562f13c6c10849d10b3387c8cdaeb4d1a2e32746a79063cba9dd284cf28c26a01c3bf4169b7d3b31b4a5586cc970d6749463108073c",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.10.0",
      "onFail": "error"
    }
  },
  "type": "module",
  "scripts": {
    "test": "playwright test --grep-invert @quarantine",
    "test:headed": "playwright test --grep-invert @quarantine --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "typecheck": "tsc -p tsconfig.json",
    "check": "node scripts/check-consistency.mjs",
    "test:smoke": "playwright test --grep @smoke --grep-invert @quarantine",
    "test:qualify": "E2E_QUALIFY=1 playwright test --repeat-each=3 --retries=0 --workers=1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.2",
    "dotenv": "^17.4.2",
    "typescript": "^7.0.2"
  }
}
