{
  "name": "playwright-e2e-tests-template",
  "version": "1.0.0",
  "private": true,
  "description": "Test Design Docを起点にIntegration/E2Eテストを設計・管理するPlaywrightテンプレート",
  "license": "MIT",
  "engines": {
    "node": "^20.17.0 || >=22.9.0"
  },
  "packageManager": "npm@11.18.0",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.10.0",
      "onFail": "error"
    }
  },
  "type": "module",
  "scripts": {
    "test": "playwright test --grep-invert @quarantine",
    "test:headed": "playwright test --grep-invert @quarantine --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "typecheck": "tsc -p tsconfig.json",
    "check": "node scripts/check-consistency.mjs && npm run test:consistency && npm run check:skills",
    "check:skills": "node scripts/check-skills.mjs",
    "test:consistency": "node --test scripts/check-consistency.test.mjs",
    "test:smoke": "playwright test --grep @smoke --grep-invert @quarantine",
    "test:qualify": "E2E_QUALIFY=1 playwright test --repeat-each=3 --retries=0 --workers=1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.2",
    "dotenv": "^17.4.2",
    "typescript": "^7.0.2"
  }
}
